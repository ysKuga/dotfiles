{
  "permissions": {
    "allow": [
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(yarn tsc *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'input=$(cat); cmd=$(echo \"$input\" | jq -r \".command // empty\"); echo \"$cmd\" | grep -qE \"npm install|npm i\\b|yarn install|yarn add|pnpm install|pnpm add|bun install|bun add\" && bash \"$HOME/.claude/hooks/audit-repo.sh\" \"$(pwd)\"'",
            "timeout": 30000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/hooks/statusline.sh\""
  },
  "enabledPlugins": {
    "genshijin@genshijin": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "language": "japanese",
  "theme": "dark"
}
